# Conexión local (debe coincidir con docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=defcivil_local
DB_USER=defcivil
DB_PASSWORD=defcivil_local

# Puerto publicado por Docker; si 5432 está ocupado, cámbialo junto con DB_PORT
POSTGRES_HOST_PORT=5432

# En local NO definir DATABASE_URL: activa SSL y PostgreSQL local no lo usa.
# DATABASE_URL=postgres://usuario:contraseña@host:5432/base

PORT=3000

# Cambia este secreto antes de usar cualquier entorno compartido o real.
JWT_SECRET=CAMBIAR_ESTE_SECRETO_LOCAL

# Opcionales para cargas de archivos; no hacen falta para iniciar localmente.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
