# Carpeta persistente en el equipo servidor (Docker Desktop debe acceder a D:)
APP_DATA_DIR=D:/DefCivil/data
APP_HOST_PORT=3000

# Credenciales internas de PostgreSQL (no se publica el puerto de la base)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=defcivil_local
DB_USER=defcivil
DB_PASSWORD=defcivil_local

# No definir DATABASE_URL en este despliegue: activa SSL y se usa PostgreSQL local.
# DATABASE_URL=postgres://usuario:contraseña@host:5432/base

PORT=3000

# Reemplaza estos marcadores antes de iniciar; db:up lo valida.
JWT_SECRET=CAMBIAR_ESTE_SECRETO_LOCAL
ADMIN_INITIAL_PASSWORD=CAMBIAR_LA_CLAVE_INICIAL_DEL_ADMIN

# Opcionales: solo se usan para los documentos que siguen en Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
