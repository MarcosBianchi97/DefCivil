# Copiar este archivo a .env y completar antes de levantar el servidor.
# .env nunca se sube al repositorio (ver backend/.gitignore).

# --- Servidor ---
PORT=4000
# Origen permitido para CORS. En desarrollo, la URL desde donde se sirve index.html/admin.html
# (por ejemplo, la de "python3 -m http.server"). En produccion, el dominio publico del sitio.
CORS_ORIGIN=http://localhost:8000

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=defensa_civil
DB_USER=postgres
DB_PASSWORD=

# --- Autenticacion ---
# Clave secreta para firmar los JWT. Generarla, por ejemplo, con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Obligatoria: el servidor no arranca sin ella (a diferencia de una clave hardcodeada por defecto).
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Usuarios iniciales (se crean una sola vez, si no existe ya un superadmin) ---
# Si se dejan vacios, el servidor genera una contrasena aleatoria y la imprime UNA VEZ
# en la consola al arrancar (guardarla, no vuelve a mostrarse).
SEED_SUPERADMIN_USUARIO=superadmin
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_USUARIO=admin
SEED_ADMIN_PASSWORD=
