# Copiar este archivo a .env y completar antes de levantar el servidor.
# .env nunca se sube al repositorio (ver backend/.gitignore).

# --- Servidor ---
PORT=4000
# Origen permitido para CORS. Si el sitio lo sirve este mismo backend (Docker / npm start) es
# su propia URL. Si se sirve aparte (python3 -m http.server -> http://localhost:8000), usar esa.
# En produccion, el dominio publico del sitio (o la IP:puerto con la que entran los usuarios).
CORS_ORIGIN=http://localhost:4000

# --- Base de datos ---
# Es LA MISMA base que usa DefCiv: no se crea una base aparte. Usar los mismos valores
# (DB_NAME / DB_USER / DB_PASSWORD) que en el .env del proyecto DefCiv; DB_PORT es el puerto
# que ese compose publica en el host. Con docker-compose.standalone.yml, en cambio, se crea
# una base nueva con estos mismos valores.
# DB_DIALECT=sqlite queda solo como atajo de emergencia sin datos reales de DefCivil.
DB_DIALECT=postgres
DB_STORAGE=./dev.sqlite

DB_HOST=localhost
DB_PORT=5433
DB_NAME=defciv
DB_USER=defciv
DB_PASSWORD=

# --- Autenticacion ---
# Clave secreta para firmar los JWT. Generarla, por ejemplo, con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Obligatoria: el servidor no arranca sin ella (a diferencia de una clave hardcodeada por defecto).
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Usuarios iniciales (se crean una sola vez, si no existe ya un superadmin) ---
# Si se dejan vacios, el servidor genera una contrasena aleatoria y la imprime UNA VEZ
# en la consola al arrancar (guardarla, no vuelve a mostrarse).
SEED_SUPERADMIN_USUARIO=superadmin
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_USUARIO=admin
SEED_ADMIN_PASSWORD=

# --- Docker (docker-compose.yml en la raiz del proyecto) ---
# Puerto del host en el que se publica el sitio.
# APP_HOST_PORT=4000
# Nombre de la red del compose de DefCivil (docker network ls) y host de Postgres en esa red.
# DEFCIVIL_NETWORK=defciv-30-main_default
# DB_HOST_DOCKER=postgres
